[Unit]
Description=Mnemo Trust Console — read-only FastAPI window onto mnemo.* graph data
Documentation=file:///root/hackathons/datahub-agent/console/README.md
After=network-online.target datahub-stack.service
Wants=network-online.target datahub-stack.service
# Orders After=datahub-stack.service so it starts only once GMS is health-gated up (that unit's
# ExecStartPost blocks until /health answers). It also tolerates GMS lazily (first request that
# touches GMS 502s until up), so this ordering is belt-and-suspenders, not a hard requirement.

[Service]
Type=simple
User=root
WorkingDirectory=/root/hackathons/datahub-agent
Environment=DATAHUB_GMS_URL=http://localhost:8090
Environment=MNEMO_CONSOLE_PORT=8808
# DATAHUB_GMS_TOKEN=... — set here (not in a world-readable file) only if this GMS requires auth.
# NEVER add ANTHROPIC_API_KEY or any secret here: this process's job is a public-facing read tier.
ExecStart=/root/hackathons/datahub-agent/.venv/bin/uvicorn console.app:app --host 127.0.0.1 --port 8808
Restart=always
RestartSec=10
Nice=10
# Binds ONLY 127.0.0.1 (see ExecStart) — the human step that makes this reachable from the
# internet is a Cloudflare Tunnel pointed at 127.0.0.1:8808, never a --host 0.0.0.0 change here.
StandardOutput=append:/root/hackathons/datahub-agent/console/console.log
StandardError=append:/root/hackathons/datahub-agent/console/console.err.log

# Defense in depth even though the app never listens beyond loopback:
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
